# ==============================================================================
# MINIMAL UI - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in your values
# ==============================================================================

# ------------------------------------------------------------------------------
# API & Server Configuration
# ------------------------------------------------------------------------------

# Backend API URL (optional)
NEXT_PUBLIC_SERVER_URL=https://api-dev-minimal-v7.vercel.app

# Assets directory (optional)
NEXT_PUBLIC_ASSETS_DIR=

# Build configuration
BUILD_STATIC_EXPORT=false


# ------------------------------------------------------------------------------
# Firebase Configuration
# ------------------------------------------------------------------------------
# Get your Firebase config from: https://console.firebase.google.com/

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APPID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# ------------------------------------------------------------------------------
# AWS Amplify Configuration
# ------------------------------------------------------------------------------
# Get your Amplify config from: https://console.aws.amazon.com/amplify/

NEXT_PUBLIC_AWS_AMPLIFY_USER_POOL_ID=
NEXT_PUBLIC_AWS_AMPLIFY_USER_POOL_WEB_CLIENT_ID=
NEXT_PUBLIC_AWS_AMPLIFY_REGION=


# ------------------------------------------------------------------------------
# Auth0 Configuration
# ------------------------------------------------------------------------------
# Get your Auth0 config from: https://manage.auth0.com/

NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CALLBACK_URL=http://localhost:8082/auth/auth0/callback


# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Get your Supabase config from: https://app.supabase.com/

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ==============================================================================
# NOTES
# ==============================================================================
# 
# 1. Authentication Method:
#    - Default: JWT (no env vars needed)
#    - To use Firebase: Set Firebase vars above and change method in src/global-config.ts
#    - To use Amplify: Set Amplify vars above and change method in src/global-config.ts
#    - To use Auth0: Set Auth0 vars above and change method in src/global-config.ts
#    - To use Supabase: Set Supabase vars above and change method in src/global-config.ts
#
# 2. Server URL:
#    - By default, uses demo API from Minimal
#    - For local development, you can set up your own backend
#    - Guide: https://docs.minimals.cc/mock-server
#
# 3. Port:
#    - Default port is 8082 (configured in package.json scripts)
#    - Change in package.json if needed
#
# ==============================================================================

